{
  "name": "setu-billing-phase1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "sh -c 'docker start setu-postgres >/dev/null 2>&1 || docker run --name setu-postgres -e POSTGRES_DB=setu_portal -e POSTGRES_USER=setu -e POSTGRES_PASSWORD=setu_dev -p 54322:5432 -v setu_postgres_data:/var/lib/postgresql/data -d postgres:16-alpine'",
    "db:stop": "docker stop setu-postgres",
    "db:logs": "docker logs -f setu-postgres",
    "db:migrate": "node --env-file=.env server/scripts/migrate-db.js",
    "db:seed": "node --env-file=.env server/scripts/seed-db.js",
    "db:reset": "node --env-file=.env server/scripts/seed-db.js --force",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 4173",
    "dev:server": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "gmail:authorize": "node --env-file=.env server/scripts/authorize-gmail.js"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@tabler/icons-react": "^3.44.0",
    "express": "^5.1.0",
    "googleapis": "^150.0.1",
    "nodemailer": "^7.0.3",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "vite": "^8.0.14"
  }
}
